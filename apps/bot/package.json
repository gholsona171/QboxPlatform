{
  "name": "@qbox/bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\""
  },
  "dependencies": {
    "@qbox/core": "workspace:*",
    "@qbox/discord": "workspace:*",
    "@qbox/logger": "workspace:*",
    "@qbox/shared": "workspace:*"
  }
}
