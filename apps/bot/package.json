{
  "name": "@qbox/bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "deploy:commands:global": "node dist/deployCommands.js global",
    "deploy:commands:global:dry-run": "node dist/deployCommands.js global --dry-run",
    "deploy:commands:dev": "pnpm typecheck && tsx src/deployCommands.ts guild",
    "deploy:commands:dev:dry-run": "pnpm typecheck && tsx src/deployCommands.ts guild --dry-run",
    "deploy:commands:guild": "pnpm run deploy:commands:dev",
    "permissions:owner-bootstrap": "tsx src/permissionAdmin.ts owner-bootstrap",
    "permissions:migrate-legacy-admin": "tsx src/permissionAdmin.ts migrate-legacy-admin",
    "typecheck": "tsc --noEmit",
    "test": "vitest run test",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\""
  },
  "dependencies": {
    "@qbox/core": "workspace:*",
    "@qbox/discord-community": "workspace:*",
    "@qbox/database": "workspace:*",
    "@qbox/discord": "workspace:*",
    "@qbox/logger": "workspace:*",
    "@qbox/permissions": "workspace:*",
    "@qbox/shared": "workspace:*"
  }
}
