{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": null,
  "installCommand": "",
  "outputDirectory": "public",
  "rewrites": [
    {
      "source": "/auth/(.*)",
      "destination": "/api/__proxy/auth/$1"
    },
    {
      "source": "/health/(.*)",
      "destination": "/api/__proxy/health/$1"
    },
    {
      "source": "/((?!api/|auth/|health/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        }
      ]
    }
  ]
}
