{
  "rewrites": [
    {
      "source": "/auth/(.*)",
      "destination": "/api/__proxy/auth/$1"
    },
    {
      "source": "/health/(.*)",
      "destination": "/api/__proxy/health/$1"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        }
      ]
    }
  ]
}
