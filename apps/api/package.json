{
  "name": "@qbox/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/run.ts",
    "start": "node dist/run.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run test",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\""
  },
  "dependencies": {
    "@qbox/core": "workspace:*",
    "@qbox/database": "workspace:*",
    "@qbox/logger": "workspace:*",
    "@qbox/permissions": "workspace:*",
    "@qbox/shared": "workspace:*",
    "fastify": "^5.11.0",
    "zod": "^4.4.3"
  }
}

