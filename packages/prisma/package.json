{
  "name": "@qbox/prisma",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/generated/client/client.d.ts",
      "import": "./dist/generated/client/client.js"
    }
  },
  "scripts": {
    "build": "pnpm prisma:generate && tsc",
    "dev": "tsx watch src/index.ts",
    "prisma:format": "node scripts/runToolingPrisma.mjs format",
    "prisma:validate": "node scripts/runToolingPrisma.mjs validate",
    "prisma:generate": "node scripts/runToolingPrisma.mjs generate && node scripts/normalizeGenerated.mjs",
    "prisma:migrate:deploy": "prisma migrate deploy --config prisma.config.ts",
    "prisma:drift:check": "prisma migrate diff --config prisma.config.ts --from-config-datasource --to-schema ../../prisma/schema.prisma --exit-code",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.integration.json",
    "test": "vitest run --dir test",
    "test:integration": "vitest run --dir integration",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\""
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.9.1",
    "@prisma/client": "7.9.1"
  },
  "devDependencies": {
    "prisma": "7.9.1"
  }
}
