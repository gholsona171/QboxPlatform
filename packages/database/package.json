{
  "name": "@qbox/database",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "dependencies": {
    "@qbox/applications": "workspace:*",
    "@qbox/authentication": "workspace:*",
    "@qbox/discord-community": "workspace:*",
    "@qbox/discord-roles": "workspace:*",
    "@qbox/moderation": "workspace:*",
    "@qbox/permissions": "workspace:*",
    "@qbox/prisma": "workspace:*",
    "@qbox/role-menus": "workspace:*",
    "@qbox/tickets": "workspace:*"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.integration.json",
    "test": "vitest run --dir test",
    "test:integration": "vitest run --dir integration --no-file-parallelism",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\""
  }
}
