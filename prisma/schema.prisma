  allowedChannels         String[]                 @map("allowed_channels")
  deniedChannels          String[]                 @map("denied_channels")
  requiredRoles           String[]                 @map("required_roles")
  cooldownSeconds         Int                      @map("cooldown_seconds")
  triggerMode             CustomCommandTriggerMode @map("trigger_mode")
