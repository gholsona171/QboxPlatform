  allowSelfStar        Boolean              @default(false) @map("allow_self_star")
  includeBotMessages   Boolean              @default(false) @map("include_bot_messages")
  nsfw                 StarboardNsfwMode    @default(BLOCK)
  mode                 StarboardChannelMode @default(DENYLIST)
  channels             String[]
  ignoredRoles         String[]             @map("ignored_roles")
  createdAt            DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@map("starboard_configs")
}

model StarboardEntry {
