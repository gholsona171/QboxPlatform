model DiscordGuildMembershipRole {
  membershipId String   @map("membership_id") @db.Uuid
  roleId       String   @map("role_id")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  membership DiscordGuildMembership @relation(fields: [membershipId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@id([membershipId, roleId], map: "discord_guild_membership_roles_pkey")
  @@index([roleId], map: "discord_guild_membership_roles_role_idx")
  @@map("discord_guild_membership_roles")
}

model AuthenticationAuditEvent {
  id                       String                        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  action                   AuthenticationAuditAction
  outcome                  AuthenticationAuditOutcome
  reasonCode               AuthenticationAuditReasonCode @map("reason_code")
  requestId                String?                       @map("request_id") @db.Uuid
  correlationId            String                        @map("correlation_id") @db.Uuid
  actorType                AuthenticationAuditActorType? @map("actor_type")
  actorPlatformUserId      String?                       @map("actor_platform_user_id") @db.Uuid
  actorServiceIdentityId   String?                       @map("actor_service_identity_id") @db.Uuid
  targetPlatformUserId     String?                       @map("target_platform_user_id") @db.Uuid
  targetExternalIdentityId String?                       @map("target_external_identity_id") @db.Uuid
  targetBrowserSessionId   String?                       @map("target_browser_session_id") @db.Uuid
  targetOAuthTransactionId String?                       @map("target_oauth_transaction_id") @db.Uuid
  targetOAuthCredentialId  String?                       @map("target_oauth_credential_id") @db.Uuid
  targetGuildMembershipId  String?                       @map("target_guild_membership_id") @db.Uuid
  provider                 AuthenticationProvider?
  purpose                  OAuthTransactionPurpose?
  metadata                 Json                          @default("{}") @db.JsonB
  ipHmac                   String?                       @map("ip_hmac") @db.Char(64)
  userAgentHmac            String?                       @map("user_agent_hmac") @db.Char(64)
  deviceHmac               String?                       @map("device_hmac") @db.Char(64)
  metadataKeyVersion       Int?                          @map("metadata_key_version")
  occurredAt               DateTime                      @map("occurred_at") @db.Timestamptz(3)
  createdAt                DateTime                      @default(now()) @map("created_at") @db.Timestamptz(3)

  actorPlatformUser      PlatformUser?           @relation("AuthenticationAuditActorPlatformUser", fields: [actorPlatformUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  targetPlatformUser     PlatformUser?           @relation("AuthenticationAuditTargetPlatformUser", fields: [targetPlatformUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  targetExternalIdentity ExternalIdentity?       @relation("AuthenticationAuditTargetIdentity", fields: [targetExternalIdentityId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  targetBrowserSession   BrowserSession?         @relation("AuthenticationAuditTargetSession", fields: [targetBrowserSessionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  targetOAuthTransaction OAuthTransaction?       @relation("AuthenticationAuditTargetTransaction", fields: [targetOAuthTransactionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  targetOAuthCredential  OAuthCredential?        @relation("AuthenticationAuditTargetCredential", fields: [targetOAuthCredentialId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  targetGuildMembership  DiscordGuildMembership? @relation("AuthenticationAuditTargetMembership", fields: [targetGuildMembershipId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([correlationId], map: "authentication_audit_events_correlation_idx")
  @@index([actorPlatformUserId, occurredAt], map: "authentication_audit_events_actor_time_idx")
  @@index([targetPlatformUserId, occurredAt], map: "authentication_audit_events_target_user_time_idx")
  @@index([action, occurredAt], map: "authentication_audit_events_action_time_idx")
  @@map("authentication_audit_events")
}
