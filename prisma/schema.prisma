model Guild {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  discordGuildId String    @unique(map: "guild_discord_guild_id_key") @map("discord_guild_id")
  metadata       Json      @default("{}") @db.JsonB
  enabled        Boolean   @default(true)
  disabledAt     DateTime? @map("disabled_at") @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  principals       PermissionPrincipal[]
  assignments      PermissionAssignment[]
  auditScopeEvents PermissionAuditEvent[]   @relation("AuditScopeGuild")
  authMemberships  DiscordGuildMembership[]
  roleMenus        RoleMenu[]
  welcomeGoodbye   WelcomeGoodbyeConfig[]
  autoroleConfigs  AutoroleConfig[]
  autoroleRules    AutoroleRule[]
  rulesConfigs     RulesConfig[]
  counters         CommunityCounter[]
  logConfigs       ServerLogConfig[]
  embedTemplates   EmbedTemplate[]
  customCommands   CustomCommand[]
  suggestions      Suggestion[]
  starboards       StarboardConfig[]
  starboardEntries StarboardEntry[]
  roleAuditEvents  DiscordRoleAuditEvent[]
  ticketSettings   TicketSettings?
  ticketCategories TicketCategory[]
  ticketPanels     TicketPanel[]
  tickets          Ticket[]

  @@map("guilds")
}

model RoleMenu {
  id                     String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  guildId                String                   @map("guild_id") @db.Uuid
  channelId              String                   @map("channel_id")
  messageId              String?                  @map("message_id")
  title                  String
  description            String?
  presentationType       RoleMenuPresentationType @map("presentation_type")
  assignmentMode         RoleMenuAssignmentMode   @map("assignment_mode")
  status                 RoleMenuStatus           @default(DRAFT)
  revision               Int                      @default(1)
  lastOperationSource    String                   @default("SYSTEM") @map("last_operation_source")
  createdByDiscordUserId String                   @map("created_by_discord_user_id")
  createdAt              DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(3)

  guild   Guild            @relation(fields: [guildId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  options RoleMenuOption[]

  @@index([guildId, status], map: "role_menus_guild_status_idx")
  @@index([guildId, channelId, messageId], map: "role_menus_published_message_idx")
  @@map("role_menus")
}

model RoleMenuOption {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  roleMenuId          String   @map("role_menu_id") @db.Uuid
  roleId              String   @map("role_id")
  label               String
  description         String?
  emoji               String?
  position            Int
  revision            Int      @default(1)
  lastOperationSource String   @default("SYSTEM") @map("last_operation_source")
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  roleMenu RoleMenu @relation(fields: [roleMenuId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([roleMenuId, position], map: "role_menu_options_position_key")
  @@unique([roleMenuId, roleId], map: "role_menu_options_role_key")
  @@index([roleId], map: "role_menu_options_role_idx")
  @@map("role_menu_options")
}

model WelcomeGoodbyeConfig {
  id                   String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  guildId              String             @map("guild_id") @db.Uuid
  kind                 WelcomeGoodbyeKind
  enabled              Boolean            @default(false)
  channelId            String             @map("channel_id")
  messageText          String             @map("message_text")
  embedEnabled         Boolean            @default(false) @map("embed_enabled")
  embedTitle           String?            @map("embed_title")
  embedDescription     String?            @map("embed_description")
  embedColor           String?            @map("embed_color")
  thumbnailAvatar      Boolean            @default(true) @map("thumbnail_avatar")
  footer               String?
  directMessageEnabled Boolean            @default(false) @map("direct_message_enabled")
  imageUrl             String?            @map("image_url")
  roleMentionId        String?            @map("role_mention_id")
  deleteAfterSeconds   Int?               @map("delete_after_seconds")
  createdAt            DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([guildId, kind], map: "welcome_goodbye_configs_guild_kind_key")
  @@map("welcome_goodbye_configs")
}

model AutoroleConfig {
  guildId             String   @id @map("guild_id") @db.Uuid
  enabled             Boolean  @default(false)
  delaySeconds        Int      @default(0) @map("delay_seconds")
  includeBots         Boolean  @default(false) @map("include_bots")
  revision            Int      @default(1)
  lastOperationSource String   @default("SYSTEM") @map("last_operation_source")
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@map("autorole_configs")
}

model AutoroleRule {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  guildId   String   @map("guild_id") @db.Uuid
  roleId    String   @map("role_id")
  position  Int
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([guildId, roleId], map: "autorole_rules_guild_role_key")
  @@unique([guildId, position], map: "autorole_rules_guild_position_key")
  @@map("autorole_rules")
}

model RulesConfig {
  guildId             String   @id @map("guild_id") @db.Uuid
  enabled             Boolean  @default(false)
  channelId           String   @map("channel_id")
  messageText         String   @map("message_text")
  buttonLabel         String   @map("button_label")
  acceptedRoleId      String   @map("accepted_role_id")
  pendingRoleId       String?  @map("pending_role_id")
  messageId           String?  @map("message_id")
  revision            Int      @default(1)
  lastOperationSource String   @default("SYSTEM") @map("last_operation_source")
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@map("rules_configs")
}

model DiscordRoleAuditEvent {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  guildId   String   @map("guild_id") @db.Uuid
  roleId    String?  @map("role_id")
  feature   String
  operation String
  source    String
  actorType String   @map("actor_type")
  actorId   String   @map("actor_id")
  summary   String
  result    String
  metadata  Json     @default("{}") @db.JsonB
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([guildId, roleId, createdAt], map: "discord_role_audit_guild_role_created_idx")
  @@map("discord_role_audit_events")
}

model CommunityCounter {
  id              String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  guildId         String               @map("guild_id") @db.Uuid
  enabled         Boolean              @default(true)
  channelId       String               @map("channel_id")
  labelTemplate   String               @map("label_template")
  type            CommunityCounterType
  roleId          String?              @map("role_id")
  intervalSeconds Int                  @map("interval_seconds")
  lastValue       Int?                 @map("last_value")
  createdAt       DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([guildId, enabled], map: "community_counters_guild_enabled_idx")
  @@map("community_counters")
}

model ServerLogConfig {
  guildId         String               @id @map("guild_id") @db.Uuid
  enabled         Boolean              @default(false)
  events          String[]
  destinations    Json                 @default("{}") @db.JsonB
  ignoredChannels String[]             @map("ignored_channels")
