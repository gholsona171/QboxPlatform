  createdAt               DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt               DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(3)

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([guildId, name], map: "custom_commands_guild_name_key")
  @@map("custom_commands")
}

model Suggestion {
  id                  String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  guildId             String           @map("guild_id") @db.Uuid
  submitterId         String           @map("submitter_id")
  content             String
  status              SuggestionStatus @default(SUBMITTED)
  submissionMessageId String?          @map("submission_message_id")
  reviewMessageId     String?          @map("review_message_id")
  resultMessageId     String?          @map("result_message_id")
  reviewerId          String?          @map("reviewer_id")
  staffNote           String?          @map("staff_note")
  upvotes             Int              @default(0)
  downvotes           Int              @default(0)
  createdAt           DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([guildId, status, createdAt], map: "suggestions_guild_status_idx")
  @@map("suggestions")
}

model StarboardConfig {
  guildId              String               @id @map("guild_id") @db.Uuid
