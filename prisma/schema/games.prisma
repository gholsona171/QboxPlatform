// Game servers: live status for Minecraft and Steam-query games (see docs/GameServers.md).
// guildId is the Discord guild snowflake.

enum GamesServerKind {
  MINECRAFT_JAVA    @map("minecraft-java")
  MINECRAFT_BEDROCK @map("minecraft-bedrock")
  STEAM             @map("steam")
}

model GamesSettings {
  guildId                    String   @id @map("guild_id")
  playerCountTemplate        String   @default("🎮 {online}/{max} online") @map("player_count_template")
  playerCountOfflineTemplate String   @default("🔴 Offline") @map("player_count_offline_template")
  revision                   Int      @default(1)
  createdAt                  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("games_settings")
}

model GamesServer {
  id                    String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  guildId               String                @map("guild_id")
  name                  String
  kind                  GamesServerKind
  address               String
  game                  String?
  connectUrl            String?               @map("connect_url")
  statusChannelId       String?               @map("status_channel_id")
  statusMessageId       String?               @map("status_message_id")
  updateIntervalSeconds Int                   @default(60) @map("update_interval_seconds")
  playerCountChannelId  String?               @map("player_count_channel_id")
  alertChannelId        String?               @map("alert_channel_id")
  alertRoleId           String?               @map("alert_role_id")
  enabled               Boolean               @default(true)
  lastOnline            Boolean?              @map("last_online")
  onlineSince           DateTime?             @map("online_since") @db.Timestamptz(3)
  offlineSince          DateTime?             @map("offline_since") @db.Timestamptz(3)
  failureStreak         Int                   @default(0) @map("failure_streak")
  lastPolledAt          DateTime?             @map("last_polled_at") @db.Timestamptz(3)
  lastError             String?               @map("last_error")
  lastPlayerCount       Int                   @default(0) @map("last_player_count")
  lastMaxPlayers        Int                   @default(0) @map("last_max_players")
  lastRenamedAt         DateTime?             @map("last_renamed_at") @db.Timestamptz(3)
  lastChannelName       String?               @map("last_channel_name")
  createdAt             DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)
  snapshots             GamesStatusSnapshot[]

  @@index([guildId], map: "games_servers_guild_idx")
  @@map("games_servers")
}

model GamesStatusSnapshot {
  id         String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  serverId   String      @map("server_id") @db.Uuid
  online     Boolean
  players    Int
  maxPlayers Int         @map("max_players")
  at         DateTime    @default(now()) @db.Timestamptz(3)
  server     GamesServer @relation(fields: [serverId], references: [id], onDelete: Cascade)

  @@index([serverId, at], map: "games_status_snapshots_server_at_idx")
  @@map("games_status_snapshots")
}
