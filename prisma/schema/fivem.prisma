// FiveM server status (see docs/FiveM.md). guildId is the Discord guild snowflake.

model FivemSettings {
  guildId               String    @id @map("guild_id")
  serverAddress         String?   @map("server_address")
  connectUrl            String?   @map("connect_url")
  statusChannelId       String?   @map("status_channel_id")
  statusMessageId       String?   @map("status_message_id")
  updateIntervalSeconds Int       @default(60) @map("update_interval_seconds")
  alertChannelId        String?   @map("alert_channel_id")
  alertRoleId           String?   @map("alert_role_id")
  restartTimes          String[]  @map("restart_times")
  timeZone              String    @default("UTC") @map("time_zone")
  restartWarningMinutes Int[]     @map("restart_warning_minutes")
  lastOnline            Boolean?  @map("last_online")
  onlineSince           DateTime? @map("online_since") @db.Timestamptz(3)
  failureStreak         Int       @default(0) @map("failure_streak")
  lastPolledAt          DateTime? @map("last_polled_at") @db.Timestamptz(3)
  sentRestartWarnings   String[]  @map("sent_restart_warnings")
  revision              Int       @default(1)
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("fivem_settings")
}

model FivemStatusSnapshot {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  guildId    String   @map("guild_id")
  online     Boolean
  players    Int
  maxPlayers Int      @map("max_players")
  at         DateTime @default(now()) @db.Timestamptz(3)

  @@index([guildId, at], map: "fivem_status_snapshots_guild_at_idx")
  @@map("fivem_status_snapshots")
}
