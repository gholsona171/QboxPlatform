{
  "name": "qbox-platform",
  "version": "0.1.0",
  "private": true,
  "description": "A modular AI-powered management platform for Discord and FiveM communities.",
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm --parallel --filter ./apps/* dev",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:database": "pnpm --filter @qbox/prisma test:integration && pnpm --filter @qbox/database test:integration",
    "prisma:generate": "pnpm --filter @qbox/prisma prisma:generate",
    "clean": "pnpm -r clean"
  },
  "keywords": [
    "discord",
    "fivem",
    "qbox",
    "typescript",
    "platform"
  ],
  "license": "UNLICENSED",
  "packageManager": "pnpm@10.16.0",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "eslint": "^10.8.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "bullmq": "^6.0.2",
    "discord.js": "^14.27.0",
    "dotenv": "^17.4.2",
    "fastify": "^5.11.0",
    "ioredis": "^5.11.1",
    "openai": "^7.2.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "zod": "^4.4.3"
  }
}
