NODE_ENV=development

# Discord
DISCORD_TOKEN=
DISCORD_APPLICATION_ID=
DISCORD_GUILD_ID=
DISCORD_COMMAND_TIMEOUT_MS=15000
DISCORD_COMMAND_SHUTDOWN_TIMEOUT_MS=10000

# Discord OAuth browser login
DISCORD_OAUTH_CLIENT_ID=
DISCORD_OAUTH_CLIENT_SECRET=
DISCORD_OAUTH_REDIRECT_URI=http://127.0.0.1:3000/auth/discord/callback

# Database
# Temporary file-backed database until Supabase is configured:
#   pnpm db:start  ->  postgresql://qbox@127.0.0.1:5433/qbox_dev
DATABASE_URL=

# API
API_HOST=127.0.0.1
API_PORT=3000
API_PUBLIC_BASE_URL=http://127.0.0.1:3000

# Authentication keys
# Generate local-only values with: pnpm --filter @qbox/api auth:keys
AUTH_KEY_VERSION=1
AUTH_SESSION_HMAC_KEY=
AUTH_CSRF_HMAC_KEY=
AUTH_METADATA_HMAC_KEY=
AUTH_OAUTH_ENCRYPTION_KEY=

# Redis
REDIS_URL=

# OpenAI
OPENAI_API_KEY=

ADMIN_ROLE_IDS=
