NODE_ENV=development

# Discord
DISCORD_TOKEN=
DISCORD_APPLICATION_ID=
# Optional. The bot works in every server it is invited to; this only picks the
# default server for a browser that has not chosen one in the portal, and the
# target of the development-only "guild" / "clear-guild" command deployment.
# Leave empty for multi-server.
DISCORD_GUILD_ID=
DISCORD_COMMAND_TIMEOUT_MS=15000
DISCORD_COMMAND_SHUTDOWN_TIMEOUT_MS=10000
# Set to true after enabling the privileged Message Content intent in the
# Discord Developer Portal. Needed for message text in ticket transcripts
# and message-triggered custom commands.
DISCORD_MESSAGE_CONTENT_INTENT=false

# Discord OAuth browser login (scopes: identify, guilds, guilds.members.read)
DISCORD_OAUTH_CLIENT_ID=
DISCORD_OAUTH_CLIENT_SECRET=
DISCORD_OAUTH_REDIRECT_URI=http://127.0.0.1:3000/auth/discord/callback

# Database
# Temporary file-backed database until Supabase is configured:
#   pnpm db:start  ->  postgresql://qbox@127.0.0.1:5433/qbox_dev
DATABASE_URL=

# API
API_HOST=127.0.0.1
API_PORT=3000
API_PUBLIC_BASE_URL=http://127.0.0.1:3000

# Authentication keys
# Generate local-only values with: pnpm --filter @qbox/api auth:keys
AUTH_KEY_VERSION=1
AUTH_SESSION_HMAC_KEY=
AUTH_CSRF_HMAC_KEY=
AUTH_METADATA_HMAC_KEY=
AUTH_OAUTH_ENCRYPTION_KEY=

# Redis
REDIS_URL=

# OpenAI
# Optional. When set, /ask writes answers from the top 3 matching knowledge
# base articles; without it, /ask shows the best matching article.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Stream announcements (docs/Streams.md)
# Optional. Twitch needs an app: dev.twitch.tv/console -> Register Your
# Application (category Chat Bot, redirect http://localhost). Without these,
# Twitch creators cannot be added.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# Optional. Kick works without credentials through its public site; add an app
# from kick.com Settings -> Developer for the official API.
KICK_CLIENT_ID=
KICK_CLIENT_SECRET=
# Optional. YouTube works without a key by reading public pages; a Data API v3
# key makes lookups more reliable.
YOUTUBE_API_KEY=

ADMIN_ROLE_IDS=
